rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // =========================
    // USERS / PROFILE / GAME
    // =========================
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isMe(userId);

      // =========================
      // FRIENDS
      // =========================
      match /friends/{friendUid} {
        allow read: if isMe(userId);

        // Cho phép tạo bản ghi bạn bè khi dữ liệu xác định đúng UID.
        // Code social-v2.js sẽ tạo bản ghi cho cả hai người khi chấp nhận.
        allow create: if signedIn()
          && request.resource.data.uid == friendUid;

        allow update, delete: if isMe(userId);
      }
    }

    // =========================
    // FRIEND REQUESTS
    // =========================
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid;

      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid;

      allow delete: if signedIn()
        && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );
    }

    // =========================
    // PRIVATE CHAT
    // =========================
    match /privateChats/{chatId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      // =========================
      // PRIVATE MESSAGES
      // =========================
      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/privateChats/$(chatId))
             .data.participants;

        allow create: if signedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/privateChats/$(chatId))
             .data.participants
          && request.resource.data.fromUid == request.auth.uid;
      }
    }

    // =========================
    // WORLD CHAT
    // =========================
    match /worldChat/{messageId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid;
    }

    // =========================
    // LEADERBOARD
    // =========================

    // =========================
    // PLAYER MARKET
    // =========================
    match /marketListings/{listingId} {
      // Người đã đăng nhập có thể xem chợ.
      allow read: if signedIn();

      // Chỉ người bán được tạo tin của chính mình.
      allow create: if signedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.qty is int
        && request.resource.data.qty > 0
        && request.resource.data.price is int
        && request.resource.data.price > 0;

      // Người bán có thể gỡ tin; người mua có thể chuyển active -> sold
      // nhưng không được thay đổi món, số lượng, giá hay UID người bán.
      allow update: if signedIn()
        && (
          resource.data.sellerUid == request.auth.uid
          ||
          (
            resource.data.status == 'active'
            && request.resource.data.status == 'sold'
            && request.resource.data.buyerUid == request.auth.uid
            && request.resource.data.sellerUid == resource.data.sellerUid
            && request.resource.data.item == resource.data.item
            && request.resource.data.qty == resource.data.qty
            && request.resource.data.price == resource.data.price
          )
        );

      allow delete: if signedIn()
        && resource.data.sellerUid == request.auth.uid;
    }

    match /leaderboard/{userId} {
      allow read: if signedIn();
      allow create, update: if isMe(userId);
    }
  }
}