rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isPromoAdmin() {
      return signedIn()
        && request.auth.token.email == 'wapteenviet1995@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // =========================
    // USERS / PROFILE / GAME
    // =========================
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isMe(userId);

      // =========================
      // FRIENDS
      // =========================
      match /friends/{friendUid} {
        allow read: if isMe(userId);

        // Cho phép tạo bản ghi bạn bè khi dữ liệu xác định đúng UID.
        // Code social-v2.js sẽ tạo bản ghi cho cả hai người khi chấp nhận.
        allow create: if signedIn()
          && request.resource.data.uid == friendUid;

        allow update, delete: if isMe(userId);
      }
    }

    // =========================
    // FRIEND REQUESTS
    // =========================
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid;

      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid;

      allow delete: if signedIn()
        && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );
    }

    // =========================
    // PRIVATE CHAT
    // =========================
    match /privateChats/{chatId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      // =========================
      // PRIVATE MESSAGES
      // =========================
      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/privateChats/$(chatId))
             .data.participants;

        allow create: if signedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/privateChats/$(chatId))
             .data.participants
          && request.resource.data.fromUid == request.auth.uid;
      }
    }

    // =========================
    // WORLD CHAT
    // =========================
    match /worldChat/{messageId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid;
    }

    // =========================
    // SYSTEM MESSAGES / THÔNG BÁO HỆ THỐNG
    // =========================
    match /systemMessages/{messageId} {
      // Chỉ người nhận được đọc thông báo của mình.
      allow read: if signedIn()
        && resource.data.toUid == request.auth.uid;

      // Người mua có thể tạo thông báo bán hàng cho người bán.
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.type == 'market_sale';

      allow update, delete: if signedIn()
        && resource.data.toUid == request.auth.uid;
    }

    // =========================
    // PLAYER GIFTS
    // Người gửi tạo quà; chỉ người nhận được đọc và nhận/xóa quà.
    // =========================
    match /playerGifts/{giftId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.qty is int
        && request.resource.data.qty >= 1
        && request.resource.data.qty <= 999
        && request.resource.data.item in ['coin', 'carrot', 'corn', 'tomato', 'wheat']
        && (request.resource.data.item == 'coin'
          ? getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.game.coins
              == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.game.coins - request.resource.data.qty
          : getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.game.inventory[request.resource.data.item]
              == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.game.inventory[request.resource.data.item] - request.resource.data.qty);

      allow delete: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && (resource.data.item == 'coin'
          ? getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.game.coins
              == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.game.coins + resource.data.qty
          : getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.game.inventory[resource.data.item]
              == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.game.inventory[resource.data.item] + resource.data.qty);

      allow update: if false;
    }

    // PROMO CODES
    match /promoCodes/{code} {
      allow read: if signedIn();
      allow create, update, delete: if isPromoAdmin();
    }

    match /promoRedemptions/{redemptionId} {
      // ID lượt đổi mã có dạng UID_MA, vì vậy người chơi chỉ đọc được
      // tài liệu lượt đổi mã mang UID của chính mình (kể cả khi tài liệu chưa tồn tại).
      allow get: if signedIn()
        && redemptionId.matches('^' + request.auth.uid + '_.*

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code is string
        && redemptionId == request.auth.uid + '_' + request.resource.data.code
        && get(/databases/$(database)/documents/promoCodes/$(request.resource.data.code)).data.active == true
        && request.resource.data.rewards == get(/databases/$(database)/documents/promoCodes/$(request.resource.data.code)).data.rewards;
      allow update, delete: if false;
    }

    // =========================
    // LEADERBOARD
    // =========================

    // =========================
    // PLAYER MARKET
    // =========================
    match /marketListings/{listingId} {
      // Người đã đăng nhập có thể xem chợ.
      allow read: if signedIn();

      // Chỉ người bán được tạo tin của chính mình.
      allow create: if signedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.qty is int
        && request.resource.data.qty > 0
        && request.resource.data.price is int
        && request.resource.data.price > 0;

      // Người bán có thể gỡ tin; người mua có thể chuyển active -> sold
      // nhưng không được thay đổi món, số lượng, giá hay UID người bán.
      allow update: if signedIn()
        && (
          resource.data.sellerUid == request.auth.uid
          ||
          (
            resource.data.status == 'active'
            && request.resource.data.status == 'sold'
            && request.resource.data.buyerUid == request.auth.uid
            && request.resource.data.sellerUid == resource.data.sellerUid
            && request.resource.data.item == resource.data.item
            && request.resource.data.qty == resource.data.qty
            && request.resource.data.price == resource.data.price
          )
        );

      allow delete: if signedIn()
        && resource.data.sellerUid == request.auth.uid;
    }

    match /leaderboard/{userId} {
      allow read: if signedIn();
      allow create, update: if isMe(userId);
    }
  }
});

      // Không cho phép truy vấn toàn bộ danh sách lượt đổi mã.
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code is string
        && redemptionId == request.auth.uid + '_' + request.resource.data.code
        && get(/databases/$(database)/documents/promoCodes/$(request.resource.data.code)).data.active == true
        && request.resource.data.rewards == get(/databases/$(database)/documents/promoCodes/$(request.resource.data.code)).data.rewards;
      allow update, delete: if false;
    }

    // =========================
    // LEADERBOARD
    // =========================

    // =========================
    // PLAYER MARKET
    // =========================
    match /marketListings/{listingId} {
      // Người đã đăng nhập có thể xem chợ.
      allow read: if signedIn();

      // Chỉ người bán được tạo tin của chính mình.
      allow create: if signedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.qty is int
        && request.resource.data.qty > 0
        && request.resource.data.price is int
        && request.resource.data.price > 0;

      // Người bán có thể gỡ tin; người mua có thể chuyển active -> sold
      // nhưng không được thay đổi món, số lượng, giá hay UID người bán.
      allow update: if signedIn()
        && (
          resource.data.sellerUid == request.auth.uid
          ||
          (
            resource.data.status == 'active'
            && request.resource.data.status == 'sold'
            && request.resource.data.buyerUid == request.auth.uid
            && request.resource.data.sellerUid == resource.data.sellerUid
            && request.resource.data.item == resource.data.item
            && request.resource.data.qty == resource.data.qty
            && request.resource.data.price == resource.data.price
          )
        );

      allow delete: if signedIn()
        && resource.data.sellerUid == request.auth.uid;
    }

    match /leaderboard/{userId} {
      allow read: if signedIn();
      allow create, update: if isMe(userId);
    }
  }
}